# Salin ke .env; jangan unggah .env ke GitHub.
# Kosongkan SMTP untuk tetap menonaktifkan email. Akun lama tetap dapat masuk.
BAM_SMTP_HOST=
BAM_SMTP_PORT=587
BAM_SMTP_USER=
BAM_SMTP_PASSWORD=
BAM_MAIL_FROM=
BAM_PUBLIC_URL=
BAM_MAIL_QUEUE_KEY=

# Isi IP/CIDR proxy yang Anda kelola. Default kosong mengabaikan header forwarded.
# Untuk proxy Vite lokal: 127.0.0.1/32,::1/128
BAM_TRUSTED_PROXIES=

BAM_COD_CONFIRMATION_HOURS=24
BAM_PAYMENT_HOLD_MINUTES=30
BAM_MAX_OPEN_ORDERS=5
BAM_MAX_RESERVED_UNITS=1000
BAM_MAX_RESERVED_UNITS_PER_PRODUCT=200

# Pemeriksaan tanpa reservasi dan batas reservasi penawaran
BAM_REVIEW_HOURS=168
BAM_QUOTE_HOLD_HOURS=24

# WhatsApp Cloud API: konfirmasi nomor kontak dengan template Authentication / Copy code.
# Kosongkan untuk menonaktifkan pengiriman. Versi API dan nama/bahasa template mengikuti Meta.
# Isi hanya di .env server; jangan memakai awalan VITE_ atau mengunggah token ke GitHub/chat.
BAM_WHATSAPP_TOKEN=
BAM_WHATSAPP_PHONE_ID=
BAM_WHATSAPP_API_VERSION=
BAM_WHATSAPP_OTP_TEMPLATE=
BAM_WHATSAPP_OTP_LANGUAGE=id

# Opsional: cut-off keranjang toko, isi KEDUA nilai setelah kebijakan BAM ditetapkan.
# Hari sebelum tanggal pengiriman: 0-14. Waktu: HH:mm WIB. Kosong = tidak ada cut-off.
BAM_B2B_CUTOFF_DAYS_BEFORE=
BAM_B2B_CUTOFF_TIME=
