# BAM behind Cloudflare. Replace toko.example.com, install the Cloudflare Origin
# Certificate (docs/DEPLOY-PRODUKSI.md, langkah 4), then run:
#   caddy validate --config /etc/caddy/Caddyfile
#
# Chain: visitor -> Cloudflare -> Caddy (this file) -> Node on 127.0.0.1:3001
{
	servers {
		# Only Cloudflare may tell Caddy who the visitor is. Source:
		# https://www.cloudflare.com/ips-v4 and /ips-v6 (checked 10 Nov 2026).
		# Refresh this list together with deploy/firewall-cloudflare.sh.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		# Cloudflare puts the real visitor address in this header.
		client_ip_headers CF-Connecting-IP
	}
}

toko.example.com {
	# Cloudflare Origin Certificate; Cloudflare SSL/TLS mode must be "Full (strict)".
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem

	encode zstd gzip

	# The largest request the app accepts is a 20 MB catalog save by Admin.
	request_body {
		max_size 25MB
	}

	reverse_proxy 127.0.0.1:3001 {
		# Send the app exactly one address: the visitor Caddy resolved above. Without this
		# line Caddy appends the Cloudflare edge address, the app (which trusts only this
		# proxy) reads that edge address, and the per-IP rate limit lumps many buyers
		# together. BAM_TRUSTED_PROXIES must list only 127.0.0.1/32 and ::1/128.
		header_up X-Forwarded-For {client_ip}

		health_uri /api/health
		health_interval 30s
	}

	log {
		output file /var/log/caddy/bam.log {
			roll_size 20MiB
			roll_keep 10
		}
	}
}
