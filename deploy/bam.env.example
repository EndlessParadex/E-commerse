# Salin ke /etc/bam/bam.env (chmod 600, pemilik root). Jangan unggah berkas aslinya ke GitHub.
# Dibaca systemd (deploy/bam.service). Nilai berisi spasi harus diberi tanda kutip.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001

# Database perusahaan (docs/MODE-PERUSAHAAN.md). Folder ini satu-satunya yang boleh ditulis server.
BAM_INSTALL_MODE=company
BAM_DB_PATH=/var/lib/bam/company.sqlite

# Alamat website yang dibuka pembeli. HTTPS, tanpa path selain "/" pada BAM_PUBLIC_URL.
BAM_APP_ORIGIN=https://toko.example.com
BAM_PUBLIC_URL=https://toko.example.com/

# Hanya Caddy di server ini yang dipercaya. Caddy mengirim satu alamat pengunjung
# (lihat deploy/Caddyfile). Jangan tambahkan rentang Cloudflare di sini.
BAM_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# SMTP diisi Pemilik dari website (#/admin/email). Variabel lain: lihat .env.example.
