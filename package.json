{
  "name": "e-commerse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "create-admin": "node server/create-admin.js",
    "create-owner": "node server/create-admin.js --owner",
    "seed:pc": "node tools/seed-pc-demo.mjs",
    "reset:pc-passwords": "node tools/reset-pc-demo-passwords.mjs",
    "backup": "node tools/database-backup.mjs backup",
    "backup:verify": "node tools/database-backup.mjs verify",
    "backup:restore": "node tools/database-backup.mjs restore",
    "create-owner:company": "node tools/company-command.cjs owner",
    "dev:full": "concurrently --kill-others-on-fail \"npm run server\" \"npm run dev\"",
    "check:local": "node tools/check-local.cjs",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test",
    "cleanup": "node tools/rapikan-proyek.cjs",
    "dev:company": "node tools/company-command.cjs dev",
    "server:company": "node tools/company-command.cjs server",
    "create-admin:company": "node tools/company-command.cjs admin",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "dependencies": {
    "nodemailer": "10.2.1",
    "proxy-addr": "2.0.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "happy-dom": "21.0.4",
    "oxlint": "^1.81.0",
    "prettier": "3.9.10",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
